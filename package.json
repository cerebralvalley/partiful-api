{
  "name": "partiful-api",
  "version": "0.1.1",
  "description": "Unofficial Partiful API",
  "packageManager": "bun@1.3.3",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "scripts": {
    "build": "tsc",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "lint": "oxlint src",
    "lint:fix": "oxlint src --fix",
    "test": "jest --config jest.config.js",
    "prepare": "bun run build",
    "prepublishOnly": "bun test && bun run lint",
    "preversion": "bun run lint",
    "version": "bun run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cerebralvalley/partiful-api.git"
  },
  "keywords": [
    "boilerplate",
    "typescript"
  ],
  "author": "Ivan Porollo",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cerebralvalley/partiful-api/issues"
  },
  "homepage": "https://github.com/cerebralvalley/partiful-api#readme",
  "devDependencies": {
    "@types/jest": "29.4.0",
    "@types/node-fetch": "^2.6.4",
    "jest": "29.4.3",
    "oxfmt": "0.42.0",
    "oxlint": "1.57.0",
    "ts-jest": "29.0.5",
    "typescript": "4.9.5"
  },
  "files": [
    "lib/**/*"
  ],
  "dependencies": {
    "cheerio": "^1.0.0-rc.12",
    "node-fetch": "2.6.1"
  }
}
